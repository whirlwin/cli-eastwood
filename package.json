{
  "name": "cli-eastwood",
  "version": "0.0.0",
  "description": "clewd: a CLI whose features are extended at runtime by TypeScript files in ~/.config/cli-eastwood/",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/main.ts --outfile dist/clewd"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
